{
  "name": "adb-dashboard",
  "version": "2.2.0",
  "private": true,
  "license": "MIT",
  "description": "ADB debugging dashboard built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "history": "node scripts/history.js",
    "icon": "electron scripts/generate-icon.js",
    "dist": "electron-builder --win nsis zip"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.l7yee.adbdashboard",
    "productName": "ADB Dashboard",
    "electronDist": "node_modules/electron/dist",
    "files": ["*.js", "renderer/**/*", "config/commands.yaml", "resources/icon.png", "package.json"],
    "win": { "target": ["nsis", "zip"], "icon": "resources/icon.ico" }
  }
}
